    "   ✗ Less precise retrieval\n",
    "\"\"\")\n",
    "\n",
    "# ============================================================================\n",
    "# COMPARISON SUMMARY\n",
    "# ============================================================================\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"COMPARISON SUMMARY:\")\n",
    "print(\"=\" * 80)\n",
