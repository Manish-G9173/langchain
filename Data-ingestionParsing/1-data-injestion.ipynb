   "source": [
    "# ============================================================================\n",
    "# DIFFERENT TEXT SPLITTING STRATEGIES\n",
    "# ============================================================================\n",
    "# Text splitting is used to break large documents into smaller chunks\n",
    "# that can be processed by LLMs (which have token limits)\n",
    "# ============================================================================\n",
    "\n",
    "# Import the different text splitters from langchain\n",
    "from langchain_text_splitters import (\n",
    "    CharacterTextSplitter,          # Splits text by a specific character\n",
    "    RecursiveCharacterTextSplitter, # Splits hierarchically (paragraphs → sentences → words)\n",
    "    TokenTextSplitter               # Splits by number of tokens (LLM token counting)\n",
    ")\n",
    "\n",
    "# ============================================================================\n",
    "# STEP 1: LOAD THE DOCUMENT\n",
    "# ============================================================================\n",
    "from langchain_community.document_loaders import TextLoader\n",
    "\n",
    "# Load the text file\n",
    "loader = TextLoader(\"data/text_files/python_intro.txt\", encoding=\"utf-8\")\n",
    "docs = loader.load()  # Returns a list of Document objects\n",
    "\n",
    "# Extract the actual text content from the first document\n",
    "document = docs[0].page_content  # This is a string containing all the text\n",
    "\n",
    "# Print the full document to see what we're working with\n",
    "print(\"=\" * 80)\n",
    "print(\"FULL DOCUMENT:\")\n",
    "print(\"=\" * 80)\n",
    "print(document)\n",
    "print(\"\\n\" + \"=\"*80 + \"\\n\")\n",
    "\n",
    "# ============================================================================\n",
    "# STRATEGY 1: CHARACTER TEXT SPLITTER\n",
    "# ============================================================================\n",
    "# What it does: Splits text by a specific character (like space, comma, newline)\n",
    "# Best for: Simple splitting where you want to control chunk size by characters\n",
    "# ============================================================================\n",
    "\n",
    "char_splitter = CharacterTextSplitter(\n",
    "    chunk_size=100,          # Each chunk will be approximately 100 characters\n",
    "    chunk_overlap=20,        # Overlap 20 characters between chunks (preserves context)\n",
    "    separator=\" \",           # Split on spaces (keeps words intact)\n",
    "    length_function=len      # Use Python's len() function to count characters\n",
    ")\n",
    "\n",
    "# Split the document into chunks\n",
    "char_chunks = char_splitter.split_text(document)\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"CHARACTER TEXT SPLITTER:\")\n",
    "print(\"=\" * 80)\n",
    "print(f\"Total chunks created: {len(char_chunks)}\")\n",
    "print(f\"First chunk (first 50 chars): {char_chunks[0][:50]}...\")\n",
    "print(f\"Length of first chunk: {len(char_chunks[0])} characters\")\n",
    "print(f\"Second chunk: {char_chunks[1][:50]}...\")\n",
    "print(\"\\n\")\n",
    "\n",
    "# ============================================================================\n",
    "# STRATEGY 2: RECURSIVE CHARACTER TEXT SPLITTER\n",
    "# ============================================================================\n",
    "# What it does: Tries to split by different separators in order\n",
    "# It tries: paragraphs → sentences → words → characters (recursively)\n",
    "# Best for: General purpose splitting that preserves semantic meaning\n",
    "# ============================================================================\n",
    "\n",
    "recursive_splitter = RecursiveCharacterTextSplitter(\n",
    "    chunk_size=100,          # Target chunk size in characters\n",
    "    chunk_overlap=20,        # Overlap between chunks\n",
    "    separators=[             # Try these separators in order (top to bottom)\n",
    "        \"\\n\\n\",              # 1st: Split by double newline (paragraphs)\n",
    "        \"\\n\",                # 2nd: Split by single newline (lines)\n",
    "        \". \",                # 3rd: Split by period + space (sentences)\n",
    "        \" \",                 # 4th: Split by space (words)\n",
    "        \"\"                   # 5th: Split by character (last resort)\n",
    "    ],\n",
    "    length_function=len      # Use len() to count characters\n",
    ")\n",
    "\n",
    "# Split the document into chunks\n",
    "recursive_chunks = recursive_splitter.split_text(document)\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"RECURSIVE CHARACTER TEXT SPLITTER:\")\n",
    "print(\"=\" * 80)\n",
    "print(f\"Total chunks created: {len(recursive_chunks)}\")\n",
    "print(f\"First chunk (first 50 chars): {recursive_chunks[0][:50]}...\")\n",
    "print(f\"Length of first chunk: {len(recursive_chunks[0])} characters\")\n",
    "print(f\"Second chunk: {recursive_chunks[1][:50]}...\")\n",
    "print(\"\\n\")\n",
    "\n",
    "# ============================================================================\n",
    "# STRATEGY 3: TOKEN TEXT SPLITTER\n",
    "# ============================================================================\n",
    "# What it does: Splits text based on token count (not characters)\n",
    "# Why: LLMs have token limits (e.g., GPT-3.5 has 4096 tokens)\n",
    "# Best for: Preparing text for LLM consumption with exact token limits\n",
    "# ============================================================================\n",
    "\n",
    "token_splitter = TokenTextSplitter(\n",
    "    chunk_size=50,           # Each chunk will have approximately 50 tokens\n",
    "    chunk_overlap=10         # Overlap 20 tokens between chunks\n",
    ")\n",
    "\n",
    "# Split the document into token-based chunks\n",
    "token_chunks = token_splitter.split_text(document)\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"TOKEN TEXT SPLITTER:\")\n",
    "print(\"=\" * 80)\n",
    "print(f\"Total chunks created: {len(token_chunks)}\")\n",
    "print(f\"First chunk (first 50 chars): {token_chunks[0][:50]}...\")\n",
    "print(f\"Length of first chunk: {len(token_chunks[0])} characters\")\n",
    "print(\"\\n\")\n",
    "\n",
    "# ============================================================================\n",
    "# COMPARISON SUMMARY\n",
    "# ============================================================================\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"COMPARISON SUMMARY:\")\n",
    "print(\"=\" * 80)\n",
    "print(f\"CharacterTextSplitter:     {len(char_chunks)} chunks (splits by spaces)\")\n",
    "print(f\"RecursiveCharacterTextSplitter: {len(recursive_chunks)} chunks (splits hierarchically)\")\n",
    "print(f\"TokenTextSplitter:         {len(token_chunks)} chunks (splits by tokens)\")\n",
    "print(\"\\n\")\n",
    "\n",
    "# ============================================================================\n",
    "# WHEN TO USE WHICH:\n",
    "# ============================================================================\n",
    "print(\"WHEN TO USE WHICH SPLITTER:\")\n",
    "print(\"-\" * 80)\n",
    "print(\"1. CharacterTextSplitter:\")\n",
    "print(\"   → When you want simple splitting by a specific character\")\n",
    "print(\"   → When you want to control chunk size by character count\")\n",
    "print(\"   → Example: Splitting CSV data by commas, or code by semicolons\")\n",
    "print()\n",
    "print(\"2. RecursiveCharacterTextSplitter:\")\n",
    "print(\"   → When you want to preserve semantic meaning (RECOMMENDED)\")\n",
    "print(\"   → When you want to split by paragraphs/sentences naturally\")\n",
    "print(\"   → Example: Splitting articles, books, or long documents\")\n",
    "print()\n",
    "print(\"3. TokenTextSplitter:\")\n",
    "print(\"   → When you need exact token counts for LLM limits\")\n",
    "print(\"   → When you're working with different LLMs (GPT, Claude, etc.)\")\n",
    "print(\"   → Example: Preparing prompts for API calls with token limits\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# ============================================================================\n",
    "# ADVANCED: SPLITTING DOCUMENTS DIRECTLY\n",
    "# ============================================================================\n",
    "# You can also split Document objects directly (not just text strings)\n",
