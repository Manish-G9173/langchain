    "# ============================================================================\n",
    "# STRATEGY 1: CHARACTER TEXT SPLITTER\n",
    "# ============================================================================\n",
    "# What it does: Splits text by a specific character (like space, comma, newline)\n",
    "# Best for: Simple splitting where you want to control chunk size by characters\n",
    "# ============================================================================\n",
    "\n",
    "char_splitter = CharacterTextSplitter(\n",
    "    chunk_size=200,          # WHY 200? Each chunk will be ~200 characters\n",
    "                             # → Small enough to fit in context window\n",
    "                             # → Large enough to contain meaningful information\n",
    "                             # → Good for quick processing and testing\n",
    "                             \n",
    "    chunk_overlap=20,        # WHY 20? Overlap 20 characters between chunks\n",
    "                             # → Prevents losing context at chunk boundaries\n",
    "                             # → Ensures no important information is cut off\n",
    "                             # → 10% overlap (20/200) is a good balance\n",
    "                             \n",
    "    separator=\" \",           # Split on spaces (keeps words intact)\n",
    "    length_function=len      # Use Python's len() function to count characters\n",
    ")\n",
    "\n",
    "# Split the document into chunks\n",
    "char_chunks = char_splitter.split_text(document)\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"CHARACTER TEXT SPLITTER:\")\n",
    "print(\"=\" * 80)\n",
    "print(f\"Total chunks created: {len(char_chunks)}\")\n",
    "print(f\"First chunk (first 50 chars): {char_chunks[0][:50]}...\")\n",
    "print(f\"Length of first chunk: {len(char_chunks[0])} characters\")\n",
    "print(f\"Second chunk: {char_chunks[1][:50]}...\")\n",
    "print(\"\\n\")\n",
    "\n",
    "# ============================================================================\n",
    "# STRATEGY 2: RECURSIVE CHARACTER TEXT SPLITTER (RECOMMENDED)\n",
    "# ============================================================================\n",
    "# What it does: Tries to split by different separators in order\n",
    "# It tries: paragraphs → sentences → words → characters (recursively)\n",
    "# Best for: General purpose splitting that preserves semantic meaning\n",
    "# WHY THIS IS THE BEST: Maintains natural language boundaries\n",
    "# ============================================================================\n",
    "\n",
    "recursive_splitter = RecursiveCharacterTextSplitter(\n",
    "    chunk_size=200,          # WHY 200? \n",
    "                             # → Optimal for semantic search (not too small, not too large)\n",
    "                             # → Each chunk contains enough context for meaning\n",
    "                             # → 200 chars ≈ 40-50 words ≈ 1-2 paragraphs\n",
    "                             # → Good balance between specificity and context\n",
    "                             \n",
    "    chunk_overlap=20,        # WHY 20?\n",
    "                             # → 10% overlap (20/200) maintains context between chunks\n",
    "                             # → Prevents important information from being split\n",
    "                             # → Helps retrieve relevant chunks even if query spans boundaries\n",
    "                             # → Common practice: 10-20% overlap of chunk size\n",
    "                             \n",
    "    separators=[             # Try these separators in order (top to bottom)\n",
    "        \"\\n\\n\",              # 1st: Split by double newline (paragraphs) - BEST\n",
    "        \"\\n\",                # 2nd: Split by single newline (lines)\n",
    "        \". \",                # 3rd: Split by period + space (sentences)\n",
    "        \" \",                 # 4th: Split by space (words)\n",
    "        \"\"                   # 5th: Split by character (last resort)\n",
    "    ],\n",
    "    length_function=len      # Use len() to count characters\n",
    ")\n",
    "\n",
    "# WHY CHUNK SIZE 200 AND OVERLAP 20 MATTER:\n",
    "# ==========================================\n",
    "# 1. Retrieval Quality:\n",
    "#    → Chunks too small: Lose context, poor retrieval results\n",
    "#    → Chunks too large: Too much noise, irrelevant information\n",
    "#    → 200 chars is a good sweet spot for semantic search\n",
    "#\n",
    "# 2. Cost Efficiency:\n",
    "#    → Smaller chunks = fewer tokens per query = lower costs\n",
    "#    → But too small = more chunks = more API calls\n",
    "#    → 200 chars balances cost and quality\n",
    "#\n",
    "# 3. Context Window:\n",
    "#    → LLMs have token limits (e.g., 4096 for GPT-3.5)\n",
    "#    → 200 chars ≈ 50 tokens, so you can fit many chunks\n",
    "#    → Safe for all major LLMs\n",
    "#\n",
    "# 4. Overlap Benefits:\n",
    "#    → Maintains context across chunk boundaries\n",
    "#    → Example: If a sentence is split, overlap recovers it\n",
    "#    → Improves RAG (Retrieval Augmented Generation) quality\n",
    "\n",
    "# Split the document into chunks\n",
    "recursive_chunks = recursive_splitter.split_text(document)\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"RECURSIVE CHARACTER TEXT SPLITTER (RECOMMENDED):\")\n",
    "print(\"=\" * 80)\n",
    "print(f\"Total chunks created: {len(recursive_chunks)}\")\n",
    "print(f\"First chunk (first 50 chars): {recursive_chunks[0][:50]}...\")\n",
    "print(f\"Length of first chunk: {len(recursive_chunks[0])} characters\")\n",
    "print(f\"Second chunk: {recursive_chunks[1][:50]}...\")\n",
    "print(\"\\n\")\n",
    "\n",
    "# ============================================================================\n",
    "# STRATEGY 3: TOKEN TEXT SPLITTER\n",
    "# ============================================================================\n",
    "# What it does: Splits text based on token count (not characters)\n",
    "# Why: LLMs have token limits (e.g., GPT-3.5 has 4096 tokens)\n",
    "# Best for: Preparing text for LLM consumption with exact token limits\n",
    "# ============================================================================\n",
    "\n",
    "token_splitter = TokenTextSplitter(\n",
    "    chunk_size=50,           # WHY 50? Each chunk will have ~50 tokens\n",
    "                             # → 50 tokens ≈ 200 characters (for English)\n",
    "                             # → Matches our character chunk size\n",
    "                             # → Ensures consistency across chunking methods\n",
    "                             \n",
    "    chunk_overlap=10         # WHY 10? 20% overlap (10/50) \n",
    "                             # → Slightly more overlap for token-based\n",
    "                             # → Accounts for tokenization differences\n",
    ")\n",
    "\n",
    "# Split the document into token-based chunks\n",
    "token_chunks = token_splitter.split_text(document)\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"TOKEN TEXT SPLITTER:\")\n",
    "print(\"=\" * 80)\n",
    "print(f\"Total chunks created: {len(token_chunks)}\")\n",
    "print(f\"First chunk (first 50 chars): {token_chunks[0][:50]}...\")\n",
    "print(f\"Length of first chunk: {len(token_chunks[0])} characters\")\n",
    "print(\"\\n\")\n",
    "\n",
    "# ============================================================================\n",
    "# WHY CHUNK SIZE 200 AND OVERLAP 20 - DETAILED EXPLANATION\n",
    "# ============================================================================\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"WHY CHUNK_SIZE = 200 AND OVERLAP = 20?\")\n",
    "print(\"=\" * 80)\n",
    "print(\"\"\"\n",
    "1. CHUNK_SIZE = 200 CHARACTERS:\n",
    "   ✓ Small enough for fast processing\n",
