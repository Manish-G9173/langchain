    "# ============================================================================\n",
    "# DIFFERENT TEXT SPLITTING STRATEGIES\n",
    "# ============================================================================\n",
    "# Text splitting is used to break large documents into smaller chunks\n",
    "# that can be processed by LLMs (which have token limits)\n",
    "# ============================================================================\n",
    "\n",
    "# Import the different text splitters from langchain\n",
    "from langchain_text_splitters import (\n",
    "    CharacterTextSplitter,          # Splits text by a specific character\n",
    "    RecursiveCharacterTextSplitter, # Splits hierarchically (paragraphs → sentences → words)\n",
    "    TokenTextSplitter               # Splits by number of tokens (LLM token counting)\n",
    ")\n",
    "\n",
    "# ============================================================================\n",
    "# STEP 1: LOAD THE DOCUMENT\n",
    "# ============================================================================\n",
    "from langchain_community.document_loaders import TextLoader\n",
    "\n",
    "# Load the text file\n",
    "loader = TextLoader(\"data/text_files/python_intro.txt\", encoding=\"utf-8\")\n",
    "docs = loader.load()  # Returns a list of Document objects\n",
    "\n",
